+          setVideoVolume: (v: number) => {
+            videoSlider = v;
+          },
+          getTranslationVolume: () => translationSlider,
+          setTranslationVolume: (v: number) => {
+            translationSlider = v;
+          },
+          getMaxTranslationVolume: () => 100,
+          setShowDownloadTranslation() {},
+          getStatus: () => "success",
+          setShowTranslationVolume() {},
