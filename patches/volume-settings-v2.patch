+  Object.assign(h, {
+    video,
+    data: {
+      enabledAutoVolume: true,
+      autoVolumeMode: mode,
+      autoVolume: 15,
+      enabledSmartDucking: false,
+      syncVolume: true,
+      translationVolumeOffset: offset,
+      muteTranslationWithOriginal: true,
+      defaultVolume: 60,
+    },
+    volumeLinkState: {
+      initialized: false,
+      lastVideoPercent: 80,
+      lastTranslationPercent: 60,
+    },
